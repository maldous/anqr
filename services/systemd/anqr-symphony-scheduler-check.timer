# anqr-symphony-scheduler-check.timer — 5-minute scheduler health check
#
# Triggers anqr-symphony-scheduler-check.service every 5 minutes to verify
# the scheduler state file is being updated regularly.
#
# Install:
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-symphony-scheduler-check.timer

[Unit]
Description=5-minute ANQR Scheduler Health Check

[Timer]
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=default.target
