# ─── ANQR Service Environment ─────────────────────────────────────────────────
# Template: services/systemd/anqr-ops.env (committed with empty values)
# Live copy: ~/.config/systemd/user/anqr-ops.env (populated with real secrets)
#
# This file is the key inventory for all systemd service environment variables.
# Values are intentionally empty in the repository; operators populate them on
# the host. See ADR-0010 for the full secrets and symlink inventory.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Runtime paths (required by systemd services) ────────────────────────────
HOME=
JAVA_HOME=
PATH=
PNPM_HOME=

# ─── LLM / AI provider tokens ───────────────────────────────────────────────
CEREBRAS_TOKEN=
FIREWORKS_KEY=
GEMINI_TOKEN=
GOOGLE_GEMINI_API_KEY=
GROQ_TOKEN=
HUGGING_FACE_READ_TOKEN=
HUGGING_TOKEN=
MISTRAL_TOKEN=
OLLAMA_API_BASE=
OLLAMA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_TOKEN=
SAMBANOVA_TOKEN=
TOGETHER_KEY=

# ─── Codebuff / Symphony ────────────────────────────────────────────────────
CODEBUFF_API_KEY=
CONTEXT7_API_KEY=
LOG_LEVEL=
OPENCLAW_GATEWAY_TOKEN=

# ─── Linear integration ─────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=

# ─── Discord integration ────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_TEXT_CHANNEL_ID=

# ─── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_MODELS_TOKEN=
GITHUB_TOKEN=

# ─── Email / SMTP ───────────────────────────────────────────────────────────
BREVO_SMTP_KEY=
MSMTP_KEY=
MYMEMORY_EMAIL=

# ─── Cloudflare ─────────────────────────────────────────────────────────────
CLOUDFLARE_TOKEN=
CLOUDFLARE_TOKEN_READALL=
CLOUDFLARE_TOKEN_ZARAZ=

# ─── Hosting / deployment ───────────────────────────────────────────────────
NETLIFY_API_TOKEN=
SENTRY_AUTH_TOKEN=

# ─── Quality / observability ────────────────────────────────────────────────
LINKUP_API_KEY=
SNYK_TOKEN=
SONAR_HOST_URL=
SONAR_TOKEN=
SONARQUBE_TOKEN=

# ─── Mobile / native build ──────────────────────────────────────────────────
APPLE_APP_STORE_CONNECT_ISSUER_ID=
APPLE_APP_STORE_CONNECT_KEY_ID=
ARGOS_DEVICE_TYPE=
CAPACITOR_ANDROID_STUDIO_PATH=

# ─── Third-party APIs ───────────────────────────────────────────────────────
