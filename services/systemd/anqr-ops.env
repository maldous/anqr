# anqr-ops.env — Environment variables for Symphony operations
#
# Copy to ~/.config/systemd/user/anqr-ops.env and fill in real values.
# This file is a TEMPLATE — do not commit real secrets.
#
# Used by: anqr-nightly.service (EnvironmentFile directive)

LINEAR_API_KEY=REPLACE

CODEBUFF_API_KEY=cb-pat-1e65735261705247b5d3a0a076454e7fe9c37ea2a2c0c945efb506e9baf1bdf7

OLLAMA_API_BASE=http://127.0.0.1:11434

SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=REPLACE
SONARQUBE_TOKEN=REPLACE

# Discord notifications now route through OpenClaw Gateway (see OPENCLAW_GATEWAY_TOKEN below)
# DISCORD_WEBHOOK_URL is no longer used

# Linkup API key for web_search tool
# Get your API key from https://linkup.so/
LINKUP_API_KEY=REPLACE

# Context7 API key for read_docs tool
# Get your API key from https://context7.com/
CONTEXT7_API_KEY=REPLACE

# Context7 MCP server configuration (local server)
CONTEXT7_STARTUP_TIMEOUT_MS=15000
CONTEXT7_REQUEST_TIMEOUT_MS=30000

# Context7 HTTP service URL (used by Symphony Bridge)
# Default: http://127.0.0.1:4320
# CONTEXT7_HTTP_URL=http://127.0.0.1:4320

# Retrieval warm-start for Symphony Bridge
# Preloads BM25 search index + vector index metadata at bridge startup
ANQR_RETRIEVAL_WARMUP=true

# Codex SDK sandbox mode used by Symphony Bridge
CODEX_SANDBOX_MODE=danger-full-access
DISCORD_BOT_TOKEN=
# DISCORD_WEBHOOK_ENABLED is no longer used

# OpenClaw Gateway API for voice announcements and tool proxying
# This token should match the one in .openclaw/openclaw.json → gateway.auth.token
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=6632920657f34f9315104491432b536d65f6513626c60b78
VOICE_ANNOUNCEMENTS_ENABLED=true
DISCORD_BOT_TOKEN=
