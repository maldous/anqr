# anqr-discord-bridge@.timer — Discord/OpenClaw bridge timer (worktree template)
#
# Starts and keeps alive Discord/OpenClaw Gateway instances in worktrees.
# These handle Discord interactive requests.
#
# Install:
#   systemctl --user enable --now anqr-discord-bridge@5.timer
#   systemctl --user enable --now anqr-discord-bridge@6.timer
#   systemctl --user enable --now anqr-discord-bridge@7.timer
#   systemctl --user enable --now anqr-discord-bridge@8.timer
#
# Check status:
#   systemctl --user list-timers | grep discord

[Unit]
Description=ANQR Discord bridge timer (worktree %i)

[Timer]
# Start immediately and keep running
OnBootSec=10s
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target