# anqr-nightly.service — Symphony nightly operations
#
# Runs the full nightly pipeline: harness → queue-control → guardian → notify → archive
#
# Install as user service:
#   cp services/systemd/anqr-nightly.service ~/.config/systemd/user/
#   cp services/systemd/anqr-nightly.timer ~/.config/systemd/user/
#   cp services/systemd/anqr-ops.env ~/.config/systemd/user/
#   # Edit ~/.config/systemd/user/anqr-ops.env with real LINEAR_API_KEY
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-nightly.timer
#
# Legacy lesson: PATH under systemd differs from interactive shells.
# nvm-installed Node is not on the default PATH. Explicit paths required.

[Unit]
Description=ANQR Symphony nightly operations pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules
Environment=NODE_OPTIONS=--max-old-space-size=2048
Environment=OLLAMA_API_BASE=http://localhost:11434

# Secrets and overrides (LINEAR_API_KEY, etc.)
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

# Runs in mutating mode with tests and sonar skipped.
# Add --dry-run to disable mutations for testing.
ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node harness/ops/nightly-ops-pass.mjs --skip-tests --skip-sonar

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-nightly

# Safety limits
TimeoutStartSec=600
MemoryMax=4G
MemorySwapMax=0
CPUQuota=80%

[Install]
WantedBy=default.target
