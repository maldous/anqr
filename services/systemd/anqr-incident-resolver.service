[Unit]
Description=ANQR Incident Auto-Resolver
Documentation=docs/harness/README.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/src/anqr
EnvironmentFile=/home/user/src/anqr/services/systemd/anqr-ops.env
ExecStart=/usr/bin/node scripts/ops/integrations/linear/incident-resolution.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-incident-resolver

[Install]
WantedBy=default.target
