# anqr-codebuff-bridge@.service — Codebuff bridge for worktree %i
#
# ⚠️ DEPRECATED (2026-03-31) ⚠️
# This service is deprecated per ADR-0003. Codebuff SDK functionality is now
# integrated directly into Symphony bridges (anqr-symphony-bridge@.service).
# Do not enable new instances. Existing instances will be removed in a future release.
#
# Template service for running Codebuff bridges in isolated worktrees.
# Each instance runs in its own worktree with isolated working directory and git state.
#
# Port mapping:
#   wt1 → port 4331
#   wt2 → port 4332
#   wt3 → port 4333
#   wt4 → port 4334
#   wt5 → port 4335
#   wt6 → port 4336
#   wt7 → port 4337
#   wt8 → port 4338
#
# Install:
#   cp services/systemd/anqr-codebuff-bridge@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-codebuff-bridge@{1,2,3,4,5,6,7,8}.service

[Unit]
Description=ANQR Codebuff bridge for worktree wt%i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# CRITICAL: Run in the target worktree directory, not the main repo.
# The script itself is launched from the control-plane checkout so one repo patch
# immediately updates every bridge instance without manually patching each worktree.
WorkingDirectory=%h/src/anqr-wt%i

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules

# Worktree identification
Environment=ANQR_WORKTREE_ID=wt%i
Environment=ANQR_WORKTREE_PATH=%h/src/anqr-wt%i

# Bridge configuration — port is 4330 + worktree number
Environment=CODEBUFF_BRIDGE_PORT=433%i
Environment=CODEBUFF_BRIDGE_API_KEY=local-bridge
Environment=CODEBUFF_BRIDGE_CWD=%h/src/anqr-wt%i

# Codebuff API keys from ops env
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node --max-old-space-size=2048 --expose-gc %h/src/anqr/scripts/ops/integrations/model/codebuff-openai-bridge.mjs

# Logging to journal with worktree identifier
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-codebuff-bridge-wt%i

# Restart on failure with exponential backoff
Restart=on-failure
RestartSec=5

# Safety limits (same as main bridge)
TimeoutStartSec=30
MemoryHigh=3G
MemoryMax=3584M

[Install]
WantedBy=default.target
