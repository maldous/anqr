[Unit]
Description=ANQR Symphony Worktree Recovery Daemon
After=network.target
Wants=anqr-symphony-integrator.service

[Service]
Type=simple
ExecStart=/home/user/.nvm/versions/node/v25.8.0/bin/node scripts/ops/orchestration/symphony-worktree-recovery.mjs daemon
WorkingDirectory=/home/user/src/anqr
Restart=on-failure
RestartSec=30
Environment=NODE_ENV=production
Environment=ANQR_AUTOMATION_COMMIT=1
Environment=ANQR_AUTOMATION_PUSH=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-recovery

[Install]
WantedBy=default.target
