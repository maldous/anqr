[Unit]
Description=ANQR Symphony Worktree Recovery Daemon
After=network.target
Wants=anqr-symphony-integrator.service

[Service]
Type=simple
ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node %h/src/anqr/harness/ops/orchestration/symphony-worktree-recovery.mjs daemon
WorkingDirectory=%h/src/anqr
Restart=on-failure
RestartSec=30
# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules
Environment=NODE_ENV=production
Environment=ANQR_AUTOMATION_COMMIT=1
Environment=ANQR_AUTOMATION_PUSH=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-recovery

[Install]
WantedBy=default.target
