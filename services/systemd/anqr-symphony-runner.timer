# anqr-symphony-runner.timer — Retired compatibility timer
#
# Legacy installs should disable/remove this timer and use the worktree template
# timers instead:
#   systemctl --user disable --now anqr-symphony-runner.timer
#   rm ~/.config/systemd/user/anqr-symphony-runner.timer
#   systemctl --user enable --now anqr-symphony-runner@1.timer
#
# Until clean-up happens, this timer only logs a reminder via the no-op service.

[Unit]
Description=ANQR Symphony runner timer (retired legacy single-runner)

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
Persistent=false

[Install]
WantedBy=timers.target
