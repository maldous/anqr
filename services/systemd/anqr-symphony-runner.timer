# anqr-symphony-runner.timer — Symphony execution agent schedule
#
# Fires every 2 minutes after the last activation. Since the service
# is Type=oneshot, systemd won't start a new instance while one is
# running. The PID lock in the runner is a backup safety net.
#
# If the runner takes 10 min (max execution), the next run starts
# at ~12 min. If there's no work (exits in <1s), next run is at 2 min.
#
# Install:
#   cp services/systemd/anqr-symphony-runner.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-symphony-runner.timer
#
# Check status:
#   systemctl --user list-timers
#   journalctl --user -u anqr-symphony-runner.service --since today

[Unit]
Description=ANQR Symphony runner timer (continuous execution)

[Timer]
OnBootSec=5min
OnUnitActiveSec=2min
Persistent=true

[Install]
WantedBy=timers.target
