[Unit]
Description=LiteLLM Proxy — Ollama tool-call translator for Codex CLI
After=network.target

[Service]
Type=simple
Environment=LITELLM_LOG=WARNING
EnvironmentFile=%h/.config/symphony/anqr.env
ExecStart=%h/.local/bin/litellm --config %h/src/anqr/scripts/ops/integrations/model/litellm-config.yaml --port 4010 --host 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
