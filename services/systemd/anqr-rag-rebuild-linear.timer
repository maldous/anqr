# anqr-rag-rebuild-linear.timer — Schedule Linear RAG index rebuilds
#
# Fires at 02:45 local time daily (15 min after Linear export at 02:30).
# Persistent=true ensures a missed run (e.g. machine was off) is caught up.
#
# Install:
#   cp services/systemd/anqr-rag-rebuild-linear.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-rag-rebuild-linear.timer
#
# Check status:
#   systemctl --user list-timers
#   journalctl --user -u anqr-rag-rebuild-linear.service --since today

[Unit]
Description=ANQR Linear RAG vector index rebuild timer

[Timer]
OnCalendar=*-*-* 02:45:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
