# anqr-rag-rebuild-linear.service — Rebuild Linear RAG vector index
#
# Runs the Linear RAG index builder to re-index exported Linear issues using
# Ollama embeddings. Designed to run as a periodic oneshot via timer.
#
# Install as user service:
#   cp services/systemd/anqr-rag-rebuild-linear.service ~/.config/systemd/user/
#   cp services/systemd/anqr-rag-rebuild-linear.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-rag-rebuild-linear.timer

[Unit]
Description=ANQR Linear RAG vector index rebuild
After=network-online.target anqr-linear-export.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=/home/user/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/user
Environment=NODE_PATH=/home/user/.nvm/versions/node/v25.8.0/lib/node_modules
Environment=NODE_OPTIONS=--max-old-space-size=2048
Environment=OLLAMA_API_BASE=http://localhost:11434

# Secrets and overrides
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

ExecStart=/home/user/.nvm/versions/node/v25.8.0/bin/node scripts/ops/lib/rag/build-index-linear.mjs

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-rag-rebuild-linear

# Safety limits — embedding generation can be slow
TimeoutStartSec=600
MemoryMax=4G

[Install]
WantedBy=default.target
