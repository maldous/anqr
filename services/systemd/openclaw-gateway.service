[Unit]
Description=OpenClaw Gateway (v2026.4.27)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node %h/src/openclaw/dist/index.js gateway --port 18789
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
# Secrets loaded from env files — no inline secrets in committed unit files
EnvironmentFile=%h/.config/systemd/user/anqr-ops.env
EnvironmentFile=-%h/.config/symphony/anqr.env
Environment=HOME=%h
Environment=TMPDIR=/tmp
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:%h/.local/share/pnpm:%h/.nvm/current/bin:%h/.local/bin:%h/.npm-global/bin:%h/bin:%h/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin:%h/.volta/bin:%h/.asdf/shims:%h/.bun/bin:%h/.fnm/current/bin
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.4.27

[Install]
WantedBy=default.target
