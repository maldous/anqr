# anqr-codebuff-bridge.service — Codebuff OpenAI-compatible API bridge
#
# Exposes Codebuff SDK as an OpenAI-compatible HTTP server for OpenClaw.
# Endpoints: /v1/models, /v1/chat/completions, /chat/completions, /health
#
# Install as user service:
#   cp services/systemd/anqr-codebuff-bridge.service ~/.config/systemd/user/
#   cp services/systemd/anqr-codebuff-bridge.timer ~/.config/systemd/user/
#   cp services/systemd/anqr-ops.env ~/.config/systemd/user/
#   # Edit ~/.config/systemd/user/anqr-ops.env with real CODEBUFF_API_KEY
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-codebuff-bridge.service

[Unit]
Description=ANQR Codebuff OpenAI-compatible bridge for OpenClaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=/home/user/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/user
Environment=NODE_PATH=/home/user/.nvm/versions/node/v25.8.0/lib/node_modules

# Bridge configuration
Environment=CODEBUFF_BRIDGE_PORT=4318
Environment=CODEBUFF_BRIDGE_API_KEY=local-bridge

# Codebuff API keys from ops env
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

ExecStart=/home/user/.nvm/versions/node/v25.8.0/bin/node --max-old-space-size=4096 --expose-gc scripts/ops/integrations/model/codebuff-openai-bridge.mjs

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-codebuff-bridge

# Restart on failure with exponential backoff
Restart=on-failure
RestartSec=5

# Safety limits — host has 64 GB RAM; be generous to avoid cgroup throttle.
# MemoryHigh must exceed --max-old-space-size by ≥512 MB for native overhead.
TimeoutStartSec=30
MemoryHigh=5120M
MemoryMax=6G

[Install]
WantedBy=default.target
