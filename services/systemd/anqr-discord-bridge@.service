# anqr-discord-bridge@.service — Discord/OpenClaw Gateway bridge (worktree template)
#
# Template service for Discord interactive request handling in worktrees.
# Each instance operates in its own worktree with isolated working directory.
# These handle Discord bot interactions via OpenClaw Gateway.
#
# Install:
#   cp services/systemd/anqr-discord-bridge@.service ~/.config/systemd/user/
#   cp services/systemd/anqr-discord-bridge@.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-discord-bridge@5.timer
#   systemctl --user enable --now anqr-discord-bridge@6.timer
#   systemctl --user enable --now anqr-discord-bridge@7.timer
#   systemctl --user enable --now anqr-discord-bridge@8.timer
#
# Check status:
#   systemctl --user status anqr-discord-bridge@5.service

[Unit]
Description=ANQR Discord/OpenClaw bridge (worktree %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/anqr-wt%i

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules

# Worktree identification
Environment=ANQR_WORKTREE_ID=wt%i
Environment=ANQR_WORKTREE_PATH=%h/src/anqr-wt%i
Environment=DISCORD_WORKTREE=true

# Discord configuration
Environment=DISCORD_BOT_TOKEN
Environment=DISCORD_SERVER_ID=1486262757543121021
Environment=DISCORD_TEXT_CHANNEL_ID=1486262758256410646
Environment=DISCORD_VOICE_CHANNEL_ID=1486262758256410647

# OpenClaw Gateway configuration
# Use shared gateway at port 18789 to avoid Bonjour hostname conflicts
# Each worktree still has its own configuration but all route to same gateway
Environment=OPENCLAW_PORT=18789
Environment=OPENCLAW_GATEWAY_HOST=127.0.0.1
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_CONFIG_PATH=%h/src/anqr-wt%i/.openclaw/openclaw.json
Environment=OPENCLAW_LOCK_DIR=%h/.cache/anqr-openclaw
Environment=OPENCLAW_CLI=openclaw

# Secrets and overrides
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env
EnvironmentFile=-%h/.config/symphony/anqr.env

# Launch the gateway singleton wrapper so only one OpenClaw gateway process
# runs across wt5-wt8 and Bonjour advertiser loops stay disabled.
ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node %h/src/anqr-wt%i/scripts/ops/runtime/discord/openclaw-gateway-singleton.mjs

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-discord-bridge-wt%i

# Restart on failure
Restart=on-failure
RestartSec=5

# Safety limits
TimeoutStartSec=60
MemoryHigh=2048M
MemoryMax=3G

[Install]
WantedBy=default.target
