# anqr-watchdog.service — Watchdog for Symphony router and executors
#
# Monitors the Symphony router (control plane) and worktree-local executors,
# automatically rolling back to previous git commit if a service fails to
# start within 60 seconds after a restart.
#
# Install as user service:
#   cp services/systemd/anqr-watchdog.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-watchdog.service

[Unit]
Description=ANQR Symphony Router and Executor Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/anqr

# Explicit PATH for git and node commands
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h

# Check interval (every 60 seconds)
Environment=WATCHDOG_CHECK_INTERVAL=60

# Systemd env overrides
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env
EnvironmentFile=-%h/.config/symphony/anqr.env

ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node scripts/ops/runtime/watchdog/bridge-watchdog.mjs

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-watchdog

# Restart on failure
Restart=on-failure
RestartSec=10

# Safety limits
TimeoutStartSec=30
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=default.target
