# anqr-linear-webhook.service - Linear webhook event receiver
#
# Receives webhook events from Linear and forwards to Symphony router.
# Replaces timer-based polling with event-driven processing.
#
# Install:
#   cp services/systemd/anqr-linear-webhook.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-linear-webhook.service
#
# Configure in Linear:
#   Settings -> API -> New webhook
#   URL: http://127.0.0.1:18791/linear/webhook
#   Resource types: Issue, Comment

[Unit]
Description=ANQR Linear webhook receiver (event-driven ingress)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/anqr

# Explicit PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules

# Webhook configuration
Environment=LINEAR_WEBHOOK_PORT=18795
Environment=LINEAR_WORKTREES=1,2,3,4

# Secrets — E Phase 3: fail fast on missing env (LINEAR_WEBHOOK_SECRET required)
EnvironmentFile=%h/.config/systemd/user/anqr-ops.env
EnvironmentFile=-%h/.config/symphony/anqr.env

ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node %h/src/anqr/harness/ops/integrations/model/linear-webhook-receiver.mjs

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-linear-webhook

# Restart on failure
Restart=on-failure
RestartSec=5

# Safety limits
TimeoutStartSec=30
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=default.target