# anqr-context7-mcp.service — Context7 MCP documentation service
#
# Runs the Context7 MCP server as an HTTP service so other ANQR services
# (Symphony Bridge, etc.) can fetch library documentation locally without
# spawning their own MCP child processes.
#
# Endpoints:
#   POST /v1/resolve-docs  — Resolve library documentation
#   GET  /health           — Health check
#
# Install as user service:
#   cp services/systemd/anqr-context7-mcp.service ~/.config/systemd/user/
#   cp services/systemd/anqr-ops.env ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-context7-mcp.service

[Unit]
Description=ANQR Context7 MCP Documentation Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules

# Service configuration
Environment=CONTEXT7_HTTP_PORT=4320

# Systemd env overrides (CONTEXT7_API_KEY, etc.)
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node harness/ops/runtime/mcp/context7-http-service.mjs

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-context7-mcp

# Restart on failure with backoff
Restart=on-failure
RestartSec=10

# Safety limits — this is a lightweight service
TimeoutStartSec=30
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=default.target
