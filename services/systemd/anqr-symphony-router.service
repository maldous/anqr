# anqr-symphony-router.service — Symphony orchestration control plane
#
# Global router that receives work from Discord and Linear ingress points.
# Routes requests to worktree-local Symphony executors (wt1-wt8).
#
# Architecture:
#   Discord → OpenClaw → Discord Router → Symphony Router → Executors wt5-wt8
#   Linear  → Linear Webhook → Symphony Router → Executors wt1-wt4

[Unit]
Description=ANQR Symphony router (control plane / orchestration)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/anqr

Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules

Environment=SYMPHONY_AGENT_PORT=4319
Environment=SYMPHONY_AGENT_WORKTREES=1,2,3,4,5,6,7,8
Environment=SYMPHONY_AGENT_MAX_CONCURRENT=8

# E Phase 3: Router requires provider tokens and API keys — fail fast on missing env
EnvironmentFile=%h/.config/systemd/user/anqr-ops.env
EnvironmentFile=-%h/.config/symphony/anqr.env

ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node %h/src/anqr/harness/ops/integrations/model/symphony-agent-router.mjs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-symphony-agent

Restart=on-failure
RestartSec=5

TimeoutStartSec=30
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=default.target
