# anqr-symphony-bridge.service — Symphony OpenAI-compatible API bridge with AI SDK
#
# Exposes Symphony's credit-gate provider selection and tool execution as an
# OpenAI-compatible HTTP server for OpenClaw.
# Endpoints: /v1/models, /v1/chat/completions, /health, /v1/metrics, /v1/stats
#
# Install as user service:
#   cp services/systemd/anqr-symphony-bridge.service ~/.config/systemd/user/
#   cp services/systemd/anqr-ops.env ~/.config/systemd/user/
#   cp services/systemd/.gitignore ~/.config/systemd/user/
#   # Edit ~/.config/systemd/user/anqr-ops.env with real provider tokens
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-symphony-bridge.service

[Unit]
Description=ANQR Symphony OpenAI-compatible bridge with AI SDK and tool execution
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules

# Bridge configuration
Environment=SYMPHONY_BRIDGE_PORT=4319
Environment=SYMPHONY_BRIDGE_API_KEY=local-symphony
Environment=CODEX_SANDBOX_MODE=danger-full-access
Environment=ANQR_RETRIEVAL_WARMUP=true

# Provider tokens (loaded from anqr.env)
EnvironmentFile=-%h/.config/symphony/anqr.env

# Systemd env overrides (LINEAR_API_KEY, etc.)
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node --max-old-space-size=2048 --expose-gc scripts/ops/integrations/model/symphony-openai-bridge.mjs


# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-symphony-bridge

# Restart on failure with exponential backoff
Restart=on-failure
RestartSec=5

# Safety limits — host has 64 GB RAM; be generous to avoid cgroup throttle.
# MemoryHigh must exceed --max-old-space-size by ≥512 MB for native overhead.
# Reduced from 4096MB to 2048MB heap to prevent OOM (matches codebuff-bridge)
TimeoutStartSec=30
MemoryHigh=3G
MemoryMax=3584M

[Install]
WantedBy=default.target
