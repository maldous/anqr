# anqr-queue-feeder.service — Queue maintenance + backup feed
#
# Runs queue:all every 15 minutes as a safety net for Symphony:
#   - Feed: backup promote Backlog → Todo if runner self-feed missed
#   - Drain: demote overflow when queue > target_max
#   - Enforce: max concurrent agents, stale detection
#
# Primary feeding is handled by the Symphony runner itself
# (symphony-runner.mjs calls feedQueue after each issue completion).
# This timer handles maintenance duties (drain, enforce, stale
# detection) and acts as a backup feeder in case the runner
# crashes or exits without feeding.
#
# Install as user service:
#   cp services/systemd/anqr-queue-feeder.service ~/.config/systemd/user/
#   cp services/systemd/anqr-queue-feeder.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-queue-feeder.timer

[Unit]
Description=ANQR Symphony queue maintenance + backup feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=/home/user/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/user
Environment=NODE_PATH=/home/user/.nvm/versions/node/v25.8.0/lib/node_modules

# Secrets and overrides (LINEAR_API_KEY, etc.)
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

ExecStart=/home/user/.nvm/versions/node/v25.8.0/bin/node scripts/ops/symphony-queue-control.mjs --all

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-queue-feeder

# Safety limits
TimeoutStartSec=120
MemoryMax=512M

[Install]
WantedBy=default.target
