# anqr-symphony-runner.service — Retired single-runner compatibility shim
#
# This unit used to launch the main-repo Symphony runner. The harness now
# requires git worktrees, so the canonical units are the template instances in
# anqr-symphony-runner@.service/.timer.
#
# Legacy installs should disable this unit:
#   systemctl --user disable --now anqr-symphony-runner.timer
#   rm ~/.config/systemd/user/anqr-symphony-runner.service
#   rm ~/.config/systemd/user/anqr-symphony-runner.timer
#
# Keeping the unit as a no-op shim prevents failed-unit noise while operators
# clean up older installs.

[Unit]
Description=ANQR Symphony runner (retired legacy single-runner)
Documentation=https://github.com/anqr-project/anqr/docs/harness/12-concurrent-execution-with-worktrees.md

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo "ANQR: anqr-symphony-runner.service is retired. Enable anqr-symphony-runner@.timer worktree instances instead."; exit 0'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-symphony-runner-retired
RemainAfterExit=yes

[Install]
WantedBy=default.target
