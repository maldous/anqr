# anqr-symphony-runner.service — Symphony execution agent
#
# Picks up Todo issues from Linear, executes them via Ollama,
# validates results, and commits changes.
#
# Triggered by anqr-symphony-runner.timer (every 2-3 min).
# Only runs if the PID lock is available (prevents overlap).
#
# Install as user service:
#   cp services/systemd/anqr-symphony-runner.service ~/.config/systemd/user/
#   cp services/systemd/anqr-symphony-runner.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-symphony-runner.timer

[Unit]
Description=ANQR Symphony execution agent — pick up issues and implement via Ollama
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=/home/user/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/user
Environment=NODE_PATH=/home/user/.nvm/versions/node/v25.8.0/lib/node_modules
Environment=NODE_OPTIONS=--max-old-space-size=512

# Secrets and overrides (LINEAR_API_KEY, etc.)
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

# Provider API tokens (GROQ_TOKEN, GEMINI_TOKEN, OPENAI_API_KEY, etc.)
EnvironmentFile=-%h/.config/symphony/anqr.env

ExecStart=/home/user/.nvm/versions/node/v25.8.0/bin/node scripts/ops/symphony-runner.mjs --once

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-symphony-runner

# Safety limits — 125 min timeout (runner has 120 min internal limit)
TimeoutStartSec=7500
MemoryMax=4G

[Install]
WantedBy=default.target
