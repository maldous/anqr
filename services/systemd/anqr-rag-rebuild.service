# anqr-rag-rebuild.service — Rebuild RAG vector index
#
# Runs the RAG index builder to re-index project source files using
# Ollama embeddings. Designed to run as a periodic oneshot via timer.
#
# Install as user service:
#   cp services/systemd/anqr-rag-rebuild.service ~/.config/systemd/user/
#   cp services/systemd/anqr-rag-rebuild.timer ~/.config/systemd/user/
#   cp services/systemd/anqr-ops.env ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now anqr-rag-rebuild.timer

[Unit]
Description=ANQR RAG vector index rebuild
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/anqr

# Explicit PATH — nvm Node is not on default systemd PATH
Environment=PATH=%h/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=%h
Environment=NODE_PATH=%h/.nvm/versions/node/v25.8.0/lib/node_modules
Environment=NODE_OPTIONS=--max-old-space-size=8192
Environment=OLLAMA_API_BASE=http://localhost:11434

# Secrets and overrides
EnvironmentFile=-%h/.config/systemd/user/anqr-ops.env

ExecStart=%h/.nvm/versions/node/v25.8.0/bin/node scripts/ops/lib/rag/build-index.mjs

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anqr-rag-rebuild

# Safety limits — embedding generation can be slow
TimeoutStartSec=3600
MemoryMax=8G

[Install]
WantedBy=default.target
