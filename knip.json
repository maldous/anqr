{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "netlify/functions/**/*.ts",
    "scripts/*.{js,mjs,ts}",
    "tests/**/*.spec.ts",
    "tests/helpers/**/*.ts",
    "tests/fixtures/**/*.ts",
    "tests/appium/**/*.ts",
    "wdio.conf.ts",
    "src/modules/**/index.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "project": ["src/**/*.{ts,tsx}", "netlify/**/*.ts"],
  "ignore": ["android/**", ".netlify/**", "src/i18n/static/*/*.ts", "src/i18n/locales/*.json"],
  "ignoreDependencies": [
    "@commitlint/cli",
    "cspell",
    "jscpd",
    "license-checker",
    "lockfile-lint",
    "netlify-cli",
    "lefthook",
    "lint-staged",
    "serve",
    "type-coverage",
    "@capacitor/android",
    "@capacitor/ios",
    "@capacitor/filesystem",
    "@capacitor/splash-screen",
    "oxc-parser",
    "oxc-transform",
    "oxc-resolver",
    "appium",
    "appium-uiautomator2-driver",
    "appium-xcuitest-driver",
    "@wdio/appium-service",
    "@wdio/cli",
    "@wdio/local-runner",
    "@wdio/mocha-framework",
    "@wdio/spec-reporter",
    "@wdio/types",
    "webdriverio"
  ]
}
