{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "netlify/functions/**/*.ts",
    "scripts/*.{js,mjs,ts}",
    "tests/**/*.spec.ts",
    "tests/helpers/**/*.ts",
    "tests/fixtures/**/*.ts",
    "src/modules/**/index.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "project": [
    "src/**/*.{ts,tsx}",
    "netlify/**/*.ts"
  ],
  "ignore": [
    "android/**",
    ".netlify/**",
    "src/i18n/static/*/*.ts",
    "src/i18n/locales/*.json"
  ],
  "ignoreDependencies": [
    "@biomejs/biome",
    "cspell",
    "jscpd",
    "license-checker",
    "lockfile-lint",
    "netlify-cli",
    "type-coverage",
    "@capacitor/filesystem",
    "@capacitor/splash-screen"
  ]
}
