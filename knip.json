{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "treatConfigHintsAsErrors": true,

  "ignoreWorkspaces": [
    "apps/api",
    "apps/mobile",
    "packages/application/gallery",
    "packages/application/monetization",
    "packages/application/onboarding",
    "packages/analytics/ga4",
    "packages/config/build",
    "packages/config/depcruise",
    "packages/config/eslint",
    "packages/config/tsconfig",
    "packages/testing/contracts",
    "packages/testing/fakes",
    "packages/testing/fixtures",
    "packages/testing/parity",
    "packages/testing/playwright",
    "packages/ui/design-tokens",
    "packages/ui/mobile"
  ],

  "ignoreDependencies": [
    "@capacitor/android",
    "@capacitor/cli",
    "@capacitor/ios",
    "appium",
    "appium-uiautomator2-driver",
    "appium-xcuitest-driver",
    "autoprefixer"
  ],

  "ignoreBinaries": [
    "oxlint.json",
    "sonar-scanner"
  ],

  "ignoreIssues": {
    "**/*.d.ts": ["exports", "types"],
    "**/*.generated.*": ["exports", "types", "enumMembers"]
  },

  "workspaces": {
    ".": {
      "entry": [
        "harness/**/*.{js,mjs,ts}",
        "netlify/functions/**/*.ts",
        "netlify/edge-functions/**/*.ts",
        "vite.config.*",
        "vitest.config.*",
        "playwright.config.*",
        "eslint.config.*",
        "*.config.{js,ts,mjs,cjs}"
      ],
      "project": [
        "harness/**/*.{js,mjs,ts}",
        "netlify/**/*.{ts,mts}"
      ],
      "paths": {
        "@/analytics/*": [
          "packages/analytics/*/src/index.ts",
          "packages/analytics/*/src/*"
        ],
        "@/application/*": [
          "packages/application/*/src/index.ts",
          "packages/application/*/src/*"
        ],
        "@/contracts/*": [
          "packages/contracts/*/src/index.ts",
          "packages/contracts/*/src/*"
        ],
        "@/domain/*": [
          "packages/domain/*/src/index.ts",
          "packages/domain/*/src/*"
        ],
        "@/platform/*": [
          "packages/platform/*/src/index.ts",
          "packages/platform/*/src/*"
        ],
        "@/ui/*": [
          "packages/ui/*/src/index.ts",
          "packages/ui/*/src/*"
        ],
        "@/infra/*": [
          "packages/observability/*/src/index.ts",
          "packages/observability/*/src/*",
          "packages/ui/web/src/*"
        ],
        "@/lib/*": [
          "apps/web/src/lib/*",
          "packages/observability/logging/src/*",
          "packages/ui/web/src/*",
          "packages/domain/render/src/*"
        ],
        "@/*": ["src/*"]
      }
    },

    "apps/web": {
      "entry": [
        "src/boot/main.tsx",
        "src/index.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/content/gallery/**",
        "!src/i18n/locales/**",
        "!src/i18n/static/**"
      ]
    },

    "packages/*/*": {
      "entry": [
        "src/index.{ts,tsx}",
        "src/*/index.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.d.ts",
        "!**/*.generated.*"
      ]
    }
  },

  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["tests/unit/**/*.{spec,test}.ts"]
  },

  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["tests/e2e/**/*.spec.ts"]
  }
}
