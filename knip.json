{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,

  "ignoreWorkspaces": [
    "apps/api",
    "apps/mobile",
    "packages/application/gallery",
    "packages/application/monetization",
    "packages/application/onboarding",
    "packages/analytics/ga4",
    "packages/config/build",
    "packages/config/depcruise",
    "packages/config/eslint",
    "packages/config/tsconfig",
    "packages/testing/contracts",
    "packages/testing/fakes",
    "packages/testing/fixtures",
    "packages/testing/parity",
    "packages/testing/playwright",
    "packages/ui/design-tokens",
    "packages/ui/mobile"
  ],

  "ignoreDependencies": [
    "@capacitor/*",
    "@lhci/cli",
    "@stoplight/spectral-cli",
    "@testing-library/jest-dom",
    "@wdio/*",
    "appium",
    "appium-uiautomator2-driver",
    "appium-xcuitest-driver",
    "autoprefixer",
    "license-checker",
    "lint-staged",
    "lockfile-lint",
    "openapi-generator-cli",
    "pixelmatch",
    "pngjs",
    "puppeteer",
    "serve",
    "sharp",
    "swagger-cli",
    "tailwindcss",
    "type-coverage",
    "webdriverio"
  ],

  "ignoreBinaries": ["oxlint.json", "sonar-scanner"],

  "ignoreIssues": {
    "**/*.d.ts": ["exports", "types"],
    "**/*.generated.*": ["exports", "types", "enumMembers"],
    "netlify/**": ["exports"],

    "packages/domain/qr/src/analyze/**": ["files", "exports", "types"],
    "packages/domain/qr/src/cache/overlay-data-matrix.ts": ["types"],
    "packages/domain/qr/src/color/**": ["exports"],
    "packages/domain/qr/src/decode/**": ["files", "exports", "enumMembers"],
    "packages/domain/qr/src/encode/**": ["files", "exports", "types"],
    "packages/domain/qr/src/qart/**": ["files", "exports"],
    "packages/domain/qr/src/qr-decoder/api.ts": ["exports"],
    "packages/domain/qr/src/qr-encoder/**": ["files", "exports"],
    "packages/domain/qr/src/qr-generator/**": ["files", "exports", "types"],
    "packages/domain/qr/src/qr-spec/**": ["exports", "types"],
    "packages/domain/qr/src/spec/**": ["files", "exports"],

    "packages/domain/render/src/animation/**": ["files", "exports"],
    "packages/domain/render/src/canvas-factory.types.ts": ["files"],
    "packages/domain/render/src/color/**": ["files"],
    "packages/domain/render/src/dither/**": ["files", "exports"],
    "packages/domain/render/src/dither-algorithms/**": ["exports", "types"],
    "packages/domain/render/src/exporter/**": ["files", "exports"],
    "packages/domain/render/src/filters/**": ["files"],
    "packages/domain/render/src/generator/**": ["files", "exports"],
    "packages/domain/render/src/overlay/**": ["files", "exports", "types"],
    "packages/domain/render/src/qr-generator-shared/**": ["types"],
    "packages/domain/render/src/qr-spec/**": ["exports"],
    "packages/domain/render/src/server/**": ["exports"],

    "apps/web/src/features/generator/**": ["files", "types"],
    "apps/web/src/i18n/language-code.ts": ["types"],
    "apps/web/src/lib/**": ["files", "types"],
    "apps/web/src/search/**": ["files"],
    "apps/web/src/seo/**": ["files"],
    "apps/web/src/shell/header/**": ["files"],
    "apps/web/src/state/types/**": ["files"],

    "packages/application/generator/src/generation/**": ["files"],
    "packages/application/generator/src/hooks/**": ["files"],
    "packages/application/generator/src/qart/**": ["files"],
    "packages/application/generator/src/url-import/**": ["files", "types"],

    "packages/application/analyze/src/reproduce-qr-code-params.types.ts": ["types"],
    "packages/domain/analyze/src/qr-analyzer/api.ts": ["files", "exports"],
    "packages/domain/payload/src/parse-emvqr.ts": ["exports"],
    "packages/domain/payload/src/payload-generators/api.ts": ["files", "exports"],
    "packages/domain/share/src/log.tsx": ["files"],
    "packages/domain/share/src/generate-iframe-embed.tsx": ["exports"],
    "packages/domain/share/src/update-browser-url.tsx": ["exports"],
    "packages/platform/browser/src/canvas/canvas-factory.ts": ["files"],
    "packages/platform/browser/src/canvas/canvas-pool.tsx": ["exports"],
    "packages/platform/browser/src/canvas/canvas-to-blob.tsx": ["exports"],
    "packages/platform/browser/src/canvas/canvas-to-data-url.ts": ["exports"],
    "packages/platform/browser/src/clipboard/api.ts": ["files", "exports"],
    "packages/platform/browser/src/clipboard/copy-image.ts": ["exports"],
    "packages/platform/browser/src/io/api.ts": ["files", "exports"],
    "packages/platform/browser/src/io/download-blob.ts": ["exports"],
    "packages/platform/browser/src/platform/api.ts": ["files", "exports"],
    "packages/platform/node/src/server/**": ["files", "exports"],
    "packages/platform/native/src/ads/**": ["exports"],
    "packages/platform/native/src/media-store/media-store-writer.ts": ["exports"],
    "packages/observability/logging/src/logger-scope-prefixes.ts": ["types"],

    "harness/ops/integrations/linear/create-issue-template/runtime.mjs": ["exports"],
    "harness/ops/integrations/linear/validate-issue/runtime.mjs": ["exports"],
    "harness/export-linear-all/main.mjs": ["exports"],
    "harness/rename-to-standards/main.mjs": ["exports"],

    "harness/ops/core/symphony-config.mjs": ["exports"],

    "harness/ops/integrations/model/symphony-credit-gate/build-provider-selection-candidate-names.mjs": [
      "exports"
    ],
    "harness/ops/integrations/model/symphony-credit-gate/failure-state-file.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-credit-gate/get-effective-provider-score.mjs": [
      "exports"
    ],
    "harness/ops/integrations/model/symphony-credit-gate/probe-results-file.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-credit-gate/provider-lease-file.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-credit-gate/stats-file.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-openai-bridge/current-request-id.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-openai-bridge/get-request-context.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-openai-bridge/with-request-context.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-provider-health/health-state-file.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-provider-health/project-root.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-session-state/ensure-state-dir.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-session-state/project-root.mjs": ["exports"],
    "harness/ops/integrations/model/symphony-session-state/session-state-file.mjs": ["exports"]
  },

  "workspaces": {
    ".": {
      "entry": [
        "harness/**/*.{js,mjs,ts}",
        "netlify/functions/**/*.ts",
        "netlify/edge-functions/**/*.ts",
        "vite.config.*",
        "vitest.config.*",
        "vitest.integration.config.*",
        "playwright.config.*",
        "eslint.config.*",
        "*.config.{js,ts,mjs,cjs}"
      ],
      "project": [
        "harness/**/*.{js,mjs,ts}",
        "netlify/**/*.{ts,mts}",
        "vite-config/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.{ts,tsx}"
      ],
      "paths": {
        "@/analytics/*": ["packages/analytics/*/src/index.ts", "packages/analytics/*/src/*"],
        "@/application/*": ["packages/application/*/src/index.ts", "packages/application/*/src/*"],
        "@/contracts/*": ["packages/contracts/*/src/index.ts", "packages/contracts/*/src/*"],
        "@/domain/*": ["packages/domain/*/src/index.ts", "packages/domain/*/src/*"],
        "@/platform/*": ["packages/platform/*/src/index.ts", "packages/platform/*/src/*"],
        "@/ui/*": ["packages/ui/*/src/index.ts", "packages/ui/*/src/*"],
        "@/infra/*": [
          "packages/observability/*/src/index.ts",
          "packages/observability/*/src/*",
          "packages/ui/web/src/*"
        ],
        "@/lib/*": [
          "apps/web/src/lib/*",
          "packages/observability/logging/src/*",
          "packages/ui/web/src/*",
          "packages/domain/render/src/*"
        ],
        "@/*": ["src/*"]
      }
    },

    "apps/web": {
      "entry": ["src/boot/main.tsx", "src/index.ts", "src/i18n/static/*/index.ts"],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/content/gallery/**",
        "!src/i18n/locales/**",
        "!src/i18n/static/**"
      ]
    },

    "packages/*/*": {
      "entry": ["src/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },

    "packages/domain/qr": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}", "src/*/api.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },
    "packages/domain/render": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}", "src/*/api.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },
    "packages/domain/share": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },
    "packages/domain/analyze": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },
    "packages/domain/payload": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },
    "packages/application/generator": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },
    "packages/platform/browser": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    },
    "packages/platform/node": {
      "entry": ["src/index.{ts,tsx}", "src/*/index.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!**/*.d.ts", "!**/*.generated.*"]
    }
  },

  "vitest": {
    "config": ["vitest.config.ts", "vitest.integration.config.ts"],
    "entry": ["tests/unit/**/*.{spec,test}.ts", "tests/integration/**/*.{spec,test}.ts"]
  },

  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["tests/e2e/**/*.spec.ts"]
  }
}
