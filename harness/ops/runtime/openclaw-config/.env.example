# OpenClaw secrets — replace {{PLACEHOLDER}} values in config files with these
#
# Used in: openclaw.json
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
GATEWAY_AUTH_TOKEN=

# Used in: clawdbot.json
# ELEVENLABS_API_KEY (same as above)
# GATEWAY_AUTH_TOKEN (same as above)

# Used in: identity/device.json
DEVICE_ID=
DEVICE_PUBLIC_KEY=
DEVICE_PRIVATE_KEY=

# Used in: identity/device-auth.json
# DEVICE_ID (same as above)
OPERATOR_TOKEN=

# Used in: exec-approvals.json
EXEC_APPROVALS_SOCKET_PATH=
EXEC_APPROVALS_SOCKET_TOKEN=

# Used in: agents/main/agent/auth-profiles.json
CODEX_OAUTH_ACCESS_TOKEN=
CODEX_OAUTH_REFRESH_TOKEN=
CODEX_ACCOUNT_ID=
