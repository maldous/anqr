{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "scripts/**/*.mjs",
    "scripts/**/*.d.ts"
  ],
  "exclude": ["scripts/**/*.spec.ts", "scripts/**/*.test.ts"]
}
