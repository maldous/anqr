{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "harness/**/*.ts",
    "harness/**/*.mts",
    "harness/**/*.cts",
    "harness/**/*.mjs",
    "harness/**/*.d.ts"
  ],
  "exclude": ["harness/**/*.spec.ts", "harness/**/*.test.ts"]
}
