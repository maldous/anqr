new file mode 100644
index 0000000000..29f810f545
--- /dev/null
+++ b/src/agents/tools/voice-speak-tool.ts
@@ -0,0 +1,55 @@
+import { Type } from "@sinclair/typebox";
+import { getVoiceSpeakHandler } from "../../plugin-sdk/voice-speak-registry.js";
+import type { AnyAgentTool } from "./common.js";
+import { readStringParam } from "./common.js";
+
+const VoiceSpeakToolSchema = Type.Object({
+  text: Type.String({ description: "Text to speak in the Discord voice channel via TTS." }),
+  guildId: Type.Optional(
+    Type.String({ description: "Optional Discord guild ID. Uses first active voice session if omitted." }),
+  ),
+});
+
+export function createVoiceSpeakTool(): AnyAgentTool {
+  return {
+    label: "Voice Speak",
+    name: "voice_speak",
+    displaySummary: "Speak text in a Discord voice channel via TTS.",
+    description:
+      "Convert text to speech and play it through the Discord voice connection. " +
+      "The bot must already be connected to a voice channel. " +
+      "Omit guildId to use the first active voice session.",
+    parameters: VoiceSpeakToolSchema,
+    execute: async (_toolCallId, args) => {
+      const params = args as Record<string, unknown>;
+      const text = readStringParam(params, "text", { required: true });
+      const guildId = readStringParam(params, "guildId");
+
+      const speak = getVoiceSpeakHandler();
+      if (!speak) {
+        return {
+          content: [
+            {
+              type: "text",
+              text: "Voice speak is not available. No Discord voice session is active or the voice manager is not initialized.",
+            },
+          ],
+          details: { error: "no voice speak handler registered" },
+        };
+      }
+
+      const result = await speak(text, guildId || undefined);
+      return {
+        content: [
+          {
+            type: "text",
+            text: result.ok
+              ? `Speaking in voice channel: "${text.slice(0, 100)}${text.length > 100 ? "..." : ""}"`
+              : `Voice speak failed: ${result.message}`,
+          },
+        ],
+        details: { ok: result.ok, message: result.message },
+      };
+    },
+  };
+}

diff --git a/src/plugin-sdk/voice-speak-registry.ts b/src/plugin-sdk/voice-speak-registry.ts
new file mode 100644
index 0000000000..845dff8c5b
--- /dev/null
+++ b/src/plugin-sdk/voice-speak-registry.ts
@@ -0,0 +1,31 @@
+/**
+ * Global registry for the voice-speak handler.
+ *
+ * Uses globalThis to avoid module duplication issues across bundled chunks.
+ * The Discord extension registers its voice manager's speakText function here
+ * at startup. The voice_speak tool reads from this registry to play audio
+ * through the Discord voice connection.
+ */
+
+type VoiceSpeakHandler = (
+  text: string,
+  guildId?: string,
+) => Promise<{ ok: boolean; message: string }>;
+
+const REGISTRY_KEY = Symbol.for("openclaw.voice-speak-handler");
+
+interface VoiceSpeakGlobal {
+  [key: symbol]: VoiceSpeakHandler | undefined;
+}
+
+export function registerVoiceSpeakHandler(fn: VoiceSpeakHandler): void {
+  (globalThis as unknown as VoiceSpeakGlobal)[REGISTRY_KEY] = fn;
+}
+
+export function unregisterVoiceSpeakHandler(): void {
+  (globalThis as unknown as VoiceSpeakGlobal)[REGISTRY_KEY] = undefined;
+}
+
+export function getVoiceSpeakHandler(): VoiceSpeakHandler | null {
+  return (globalThis as unknown as VoiceSpeakGlobal)[REGISTRY_KEY] ?? null;
+}
