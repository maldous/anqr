+  async speakText(
+    text: string,
+    guildId?: string,
+  ): Promise<{ ok: boolean; message: string }> {
+    if (!this.voiceEnabled) {
+      return { ok: false, message: "Discord voice is disabled." };
+    }
+
+    // Find the target session
+    let entry: VoiceSessionEntry | undefined;
+    if (guildId) {
+      entry = this.sessions.get(guildId);
+      if (!entry) {
+        return { ok: false, message: `No active voice session for guild ${guildId}.` };
+      }
+    } else {
+      // Use first active session
+      const first = this.sessions.values().next();
+      if (first.done) {
+        return { ok: false, message: "No active voice sessions." };
+      }
+      entry = first.value;
+    }
+
+    const speakText = text.trim();
+    if (!speakText) {
+      return { ok: false, message: "Empty text." };
+    }
+
+    logger.info(
+      `discord voice: speakText (${speakText.length} chars): guild=${entry.guildId} channel=${entry.channelId}`,
+    );
+
+    const { cfg: ttsCfg } = resolveVoiceTtsConfig({
+      cfg: this.params.cfg,
+      override: this.params.discordConfig.voice?.tts,
+    });
+
+    const ttsResult = await textToSpeech({
+      text: speakText,
+      cfg: ttsCfg,
+      channel: "discord",
+    });
+    if (!ttsResult.success || !ttsResult.audioPath) {
+      const err = ttsResult.error ?? "unknown error";
+      logger.warn(`discord voice: speakText TTS failed: ${err}`);
+      return { ok: false, message: `TTS failed: ${err}` };
+    }
+    const audioPath = ttsResult.audioPath;
+
+    this.enqueuePlayback(entry, async () => {
+      logVoiceVerbose(
+        `speakText playback start: guild ${entry!.guildId} channel ${entry!.channelId} file ${path.basename(audioPath)}`,
+      );
+      const voiceSdk = loadDiscordVoiceSdk();
+      const resource = voiceSdk.createAudioResource(audioPath);
+      entry!.player.play(resource);
+      await voiceSdk
+        .entersState(entry!.player, voiceSdk.AudioPlayerStatus.Playing, PLAYBACK_READY_TIMEOUT_MS)
+        .catch(() => undefined);
+      await voiceSdk
+        .entersState(entry!.player, voiceSdk.AudioPlayerStatus.Idle, SPEAKING_READY_TIMEOUT_MS)
+        .catch(() => undefined);
+      logVoiceVerbose(`speakText playback done: guild ${entry!.guildId} channel ${entry!.channelId}`);
+    });
+
+    return {
+      ok: true,
+      message: `Speaking in guild ${entry.guildId} channel ${entry.channelId}: "${speakText.slice(0, 50)}${speakText.length > 50 ? '...' : ''}"`,
+    };
+  }
