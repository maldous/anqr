# ANQR build-time env vars (loaded by Vite at build/dev).
# Copy to .env (gitignored) and fill in real values.

# AdMob gating: "true" serves Google test ads (zero revenue, useful while
# Play production listing isn't approved yet). Flip to "false" once approved.
VITE_ADMOB_TESTING=true

# Production AdMob unit IDs (publisher ca-app-pub-2270701384951162).
# Empty values fall back to Google test IDs.
VITE_ADMOB_BANNER_BOTTOM=
VITE_ADMOB_BANNER_TOP=
VITE_ADMOB_INTERSTITIAL_EXPORT=
VITE_ADMOB_INTERSTITIAL_GALLERY=
VITE_ADMOB_INTERSTITIAL_GENERATION=
VITE_ADMOB_REWARDED_PREMIUM=
VITE_ADMOB_REWARDED_EXPORT_HD=

# Sentry release tag — `make ship` sets this per-build to anqr@<package.version>.
VITE_SENTRY_RELEASE=
