{
  "private": true,
  "workspaces": ["apps/*", "packages/*/*"],
  "scripts": {
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:apps": "tsc -p tsconfig.apps.json --noEmit",
    "typecheck:packages": "tsc -p tsconfig.packages.json --noEmit",
    "typecheck:harness": "tsc -p tsconfig.harness.json --noEmit",
    "typecheck:netlify": "tsc -p tsconfig.netlify.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:all": "npm run typecheck:src && npm run typecheck:apps && npm run typecheck:packages && npm run typecheck:harness && npm run typecheck:netlify && npm run typecheck:tests",
    "contracts:check": "node scripts/contracts-check.mjs",
    "depcruise:src": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:packages": "depcruise packages --config .dependency-cruiser.cjs",
    "depcruise:netlify": "depcruise netlify --config .dependency-cruiser.cjs",
    "depcruise:all": "npm run depcruise:src && npm run depcruise:packages && npm run depcruise:netlify"
  }
}
