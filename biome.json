{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      "complexity": {
        "noUselessFragments": "warn",
        "useSimplifiedLogicExpression": "warn"
      },

      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn"
      },

      "style": {
        "useConst": "error",
        "useImportType": "warn",

        "noNonNullAssertion": "off",

        "noCommonJs": "error",
        "noDefaultExport": "error",

        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "strictCase": true,
            "filenameCases": ["kebab-case", "PascalCase"]
          }
        },

        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**/", "../**/", "@/**/", "~/**/"],
                "message": "No trailing-slash imports. Import the directory, not './x/'."
              },
              {
                "group": ["**/index", "**/index.ts", "**/index.js", "**/index.tsx", "**/index.jsx"],
                "message": "No explicit index imports. Use the directory specifier."
              },
              {
                "group": ["**/internal/**", "**/internal"],
                "message": "Never import internal paths across modules. Import the module entrypoint."
              },

              {
                "group": [
                  "@modules/*/*",
                  "src/modules/*/*",
                  "@/modules/*/*",
                  "~/modules/*/*"
                ],
                "message": "No sub-APIs. Import only the module entrypoint (one segment)."
              }
            ]
          }
        }
      },

      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noTemplateCurlyInString": "off",
        "noAssignInExpressions": "off",
        "noConsole": "error",
        "noImportCycles": "error"
      },

      "a11y": {
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "warn",
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double"
    }
  },

  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },

  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.js",
      "src/**/*.jsx",
      "src/**/*.json",
      "netlify/**/*.ts",
      "tests/**/*.ts",
      "*.ts",
      "*.js"
    ],
    "ignoreUnknown": true
  },

  "overrides": [
    {
      "includes": ["src/modules/**/index.ts", "src/modules/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/i18n/static/**/*.ts", "src/i18n/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/App.tsx", "src/components/**/*.tsx", "src/hooks/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/hooks/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["netlify/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/modules/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/logger.ts",
        "src/lib/logger-remote.ts",
        "src/modules/qr-analyzer/logger.ts",
        "src/modules/overlay/overlay-filters.ts",
        "src/modules/qr-generator/**/*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "playwright.config.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "capacitor.config.ts",
        "postcss.config.js",
        "tailwind.config.js",
        "commitlint.config.cjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noCommonJs": "off"
          }
        }
      }
    }
  ]
}

