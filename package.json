    "appium": "^3.2.0",
    "appium-uiautomator2-driver": "^7.0.0",
    "appium-xcuitest-driver": "^10.26.0",
    "autoprefixer": "^10.4.24",
    "cspell": "^9.6.4",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^10.0.3",
    "eslint-import-resolver-typescript": "^4.4.4",
