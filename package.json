{
  "name": "anqr",
  "version": "1.0.69",
  "description": "These are my existing files for ANQR:",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git@github-private:maldous/anqr.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "openapi:generate": "tsx harness/generate-openapi.ts",
    "preview": "vite preview",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=2048' tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:boundaries": "eslint src/",
    "format": "oxfmt --write .",
    "format:reports": "oxfmt --write $(find reports/ -type f | grep -v rag)",
    "format:check": "oxfmt --check .",
    "depcruise": "npm run depcruise:architecture && npm run depcruise:contracts",
    "cspell": "cspell --config cspell.json --no-progress",
    "knip": "knip",
    "test": "playwright test",
    "test:unit": "NODE_OPTIONS='--no-experimental-webstorage' ANQR_LOG_LEVEL=error vitest run --maxWorkers=1",
    "test:unit:coverage": "NODE_OPTIONS='--no-experimental-webstorage' ANQR_LOG_LEVEL=error vitest run --maxWorkers=1 --coverage",
    "test:basic": "playwright test --project=basic --pass-with-no-tests",
    "test:advanced": "playwright test --project=advanced --pass-with-no-tests",
    "test:professional": "playwright test --project=professional",
    "test:permutations": "playwright test --project=permutations",
    "test:openclaw": "playwright test --project=openclaw",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:appium": "wdio run wdio.conf.ts",
    "test:appium:android": "APPIUM_PLATFORM=android wdio run wdio.conf.ts",
    "test:appium:ios": "APPIUM_PLATFORM=ios wdio run wdio.conf.ts",
    "audit:ast": "node harness/audit-ast-density.mjs",
    "ast:names": "node harness/list-ast-names.mjs",
    "sonar:export": "bash harness/sonar-export.sh",
    "sonar:mail": "node harness/ops/sonar-linear-mail.mjs",
    "sonar:scan": "NODE_OPTIONS='' SONAR_SCANNER_OPTS='-Xms128m -Xmx256m' sonar-scanner",
    "harness:quick": "node harness/ops/harness-report.mjs quick",
    "harness:continuous": "node harness/ops/harness-report.mjs continuous",
    "harness:full": "node harness/ops/harness-report.mjs full",
    "harness:doctor": "node harness/ops/harness-doctor.mjs",
    "guardian:run": "node harness/ops/linear-guardian.mjs",
    "guardian:dry-run": "node harness/ops/linear-guardian.mjs --dry-run",
    "queue:check": "node harness/ops/symphony-queue-control.mjs --check",
    "queue:feed": "node harness/ops/symphony-queue-control.mjs --feed",
    "queue:enforce": "node harness/ops/symphony-queue-control.mjs --enforce",
    "queue:all": "node harness/ops/symphony-queue-control.mjs --all",
    "queue:all:dry-run": "node harness/ops/symphony-queue-control.mjs --all --dry-run",
    "queue:continuous": "node harness/ops/symphony-queue-control.mjs --all",
    "symphony:run": "node harness/ops/symphony-runner.mjs --once",
    "symphony:run:dry-run": "node harness/ops/symphony-runner.mjs --once --dry-run",
    "symphony:status": "node harness/ops/symphony-runner.mjs --status",
    "email:ingest": "node harness/ops/email-ingest.mjs",
    "email:ingest:dry-run": "node harness/ops/email-ingest.mjs --dry-run",
    "notify:test": "node -e \"import('./harness/ops/lib/notify.mjs').then(m => { const r = m.sendNotification({ subject: 'Test notification', body: 'This is a test from ANQR ops notification system.\\nTimestamp: ' + new Date().toISOString(), severity: 'info' }); console.log(r); })\"",
    "nightly": "node harness/ops/nightly-ops-pass.mjs",
    "nightly:dry-run": "node harness/ops/nightly-ops-pass.mjs --dry-run",
    "linear:reconciler": "node harness/ops/linear-reconciler.mjs --daemon",
    "linear:reconciler:once": "node harness/ops/linear-reconciler.mjs",
    "linear:status": "node harness/ops/linear-status.mjs",
    "typecheck:src": "tsc --noEmit -p tsconfig.src.json",
    "typecheck:apps": "tsc --noEmit -p tsconfig.apps.json",
    "typecheck:packages": "tsc --noEmit -p tsconfig.packages.json",
    "typecheck:harness": "tsc --noEmit -p tsconfig.harness.json",
    "typecheck:netlify": "tsc --noEmit -p tsconfig.netlify.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:all": "npm run typecheck:src && npm run typecheck:apps && npm run typecheck:packages && npm run typecheck:netlify && npm run typecheck:tests",
    "lint:src": "oxlint src/",
    "lint:apps": "oxlint apps/",
    "lint:packages": "oxlint packages/",
    "lint:harness": "oxlint harness/",
    "lint:netlify": "oxlint netlify/",
    "lint:all": "oxlint .",
    "depcruise:src": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:packages": "depcruise packages --config .dependency-cruiser.architecture.cjs",
    "depcruise:netlify": "depcruise netlify --config .dependency-cruiser.architecture.cjs",
    "depcruise:all": "npm run depcruise:architecture && npm run depcruise:contracts && npm run depcruise:harness",
    "depcruise:architecture": "depcruise packages apps netlify --config .dependency-cruiser.architecture.cjs",
    "depcruise:contracts": "depcruise packages/contracts --config .dependency-cruiser.contracts.cjs",
    "depcruise:harness": "depcruise harness/ops --config .dependency-cruiser.harness.cjs",
    "depcruise:migration": "depcruise src packages apps netlify --config .dependency-cruiser.cjs",
    "contracts:check": "node harness/contracts-check.mjs",
    "build:web": "npm run build",
    "build:packages": "echo 'No package build step yet'",
    "build:all": "npm run build:packages && npm run build:web",
    "quality": "npm run typecheck && npm run lint && npm run depcruise && npm run test:unit",
    "prepare": "lefthook install",
    "typecheck:scripts": "npx tsc --noEmit --project tsconfig.scripts.json",
    "lint:scripts": "npx oxlint harness/ops/integrations/linear/*.mjs",
    "test:scripts": "npx vitest run harness/ops/integrations/linear",
    "depcruise:scripts": "npx depcruise harness/ops/integrations/linear --validate",
    "audit:ast:scripts": "npx jscpd --format json --output reports/jscpd/scripts.json harness/ops/integrations/linear",
    "cspell:scripts": "npx cspell harness/ops/integrations/linear/*.mjs",
    "probe:providers": "node harness/ops/provider-probe-report.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/groq": "^3.0.31",
    "@ai-sdk/openai": "^3.0.47",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@codebuff/sdk": "^0.10.7",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@napi-rs/canvas": "^0.1.90",
    "@netlify/blobs": "^10.7.0",
    "@openai/codex-sdk": "^0.116.0",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/node": "^10.38.0",
    "@sentry/react": "^10.38.0",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "ai": "^6.0.134",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jose": "^6.2.2",
    "lefthook": "^2.1.1",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "lucide-react": "^0.563.0",
    "minisearch": "^7.2.0",
    "open-location-code": "^1.0.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.1",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@sentry/vite-plugin": "^4.9.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.1",
    "@types/open-location-code": "^1.0.1",
