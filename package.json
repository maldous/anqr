  "repository": {
    "type": "git",
    "url": "git@github-private:maldous/anqr.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-openapi-public.mjs && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:basic": "playwright test --project=basic",
    "test:advanced": "playwright test --project=advanced",
    "test:professional": "playwright test --project=professional",
    "test:permutations": "playwright test --project=permutations",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:unit": "NODE_OPTIONS='--no-experimental-webstorage' ANQR_LOG_LEVEL=error vitest run --maxWorkers=100% --exclude 'tests/unit/gallery-scan-matrix.spec.ts' --exclude 'tests/unit/overlay-preservation-mode-audit.spec.ts' --exclude 'tests/unit/qr-generator-perf-profile.spec.ts'",
    "test:unit:coverage": "NODE_OPTIONS='--no-experimental-webstorage' ANQR_LOG_LEVEL=error vitest run --maxWorkers=100% --coverage --exclude 'tests/unit/gallery-scan-matrix.spec.ts' --exclude 'tests/unit/overlay-preservation-mode-audit.spec.ts' --exclude 'tests/unit/qr-generator-dithered-scan-gate.spec.ts' --exclude 'tests/unit/qr-generator-perf-profile.spec.ts' --exclude 'tests/unit/netlify-qr-function.spec.ts' --exclude 'tests/unit/netlify-qr-function-error.spec.ts' --exclude 'tests/unit/netlify-qr-helpers.spec.ts' --exclude 'tests/unit/netlify-qr-gif-disposal.spec.ts' --exclude 'tests/unit/payload-matrix-guard.spec.ts' --exclude 'tests/unit/qr-generator-artistic-guards.spec.ts'",
    "test:unit:perf": "NODE_OPTIONS='--no-experimental-webstorage' ANQR_LOG_LEVEL=error vitest run tests/unit/qr-generator-perf-profile.spec.ts",
    "test:coverage:gap": "node scripts/report-code-coverage-gap.js",
    "test:unit:watch": "NODE_OPTIONS='--no-experimental-webstorage' vitest",
    "test:unit:ci": "npm run test:unit",
    "test:ids": "node scripts/generate-test-ids.js",
    "test:required": "node scripts/generate-required-tests.js",
    "test:required:strict": "node scripts/check-required-tests.js",
    "test:required:gap": "node scripts/report-required-gap.js",
    "test:testid": "node scripts/audit-testid-coverage.js",
    "test:testid:refs": "node scripts/check-testid-references.js",
    "test:i18n": "node scripts/check-i18n-regressions.js",
    "test:bundle:budget": "node scripts/check-bundle-budgets.mjs",
    "test:perf:budget": "npm run build && node scripts/check-performance-budgets.mjs",
    "audit:ast": "node scripts/audit-ast-density.mjs",
    "quality:pmd": "bash scripts/check-pmd-cpd.sh",
    "report:payload:matrix": "node scripts/generate-payload-matrix.mjs",
    "validate:services": "node scripts/validate-third-party.mjs",
    "check:sentry": "node scripts/check-sentry-regression.mjs",
    "report:i18n:txt": "node scripts/check-i18n-txt.js --all",
    "qr:art": "npx tsx scripts/run-qr-art.ts",
    "test:signoff": "node scripts/production-signoff-check.js",
    "test:appium": "wdio run wdio.conf.ts",
    "test:appium:android": "APPIUM_PLATFORM=android wdio run wdio.conf.ts",
    "test:appium:ios": "APPIUM_PLATFORM=ios wdio run wdio.conf.ts",
    "ci:reliability-gate": "node scripts/ops/reliability-gate.mjs",
    "extract:ast": "tsx tools/refactor/extract-ast.ts"
  },
