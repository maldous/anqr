    "tailwindcss": "^4.1.18",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0",
    "webdriverio": "^9.24.0"
  },
  "overrides": {
    "@opentelemetry/semantic-conventions": ">=1.40.0",
    "axios": ">=1.13.5",
    "fastify": ">=5.8.1",
    "minimatch": ">=5.1.8",
    "qs": ">=6.14.2",
    "serialize-javascript": ">=7.0.3",
    "svgo": ">=4.0.1",
    "tar": ">=7.5.10"
  },
  "engines": {
