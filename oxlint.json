{
  "rules": {
    "no-unused-vars": "warn",
    "no-explicit-any": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "android",
    "ios",
    ".github",
    "coverage",
    "public",
    "*.generated.*"
  ]
}
