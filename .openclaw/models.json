{
  "$schema": "https://docs.openclaw.ai/schema/models.json",
  "mode": "merge",
  "providers": {
    "codebuff-bridge": {
      "baseUrl": "http://127.0.0.1:4318",
      "apiKey": "local-bridge",
      "api": "openai-completions",
      "models": [
        {
          "id": "codebuff/base@latest",
          "name": "Codebuff Base (via bridge)"
        }
      ]
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "codebuff-bridge/codebuff/base@latest"
      }
    }
  }
}