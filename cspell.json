{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules",
    "dist",
    "coverage",
    "android",
    "ios",
    "public/gallery",
    "*.generated.*",
    "package-lock.json",
    ".git"
  ],
  "words": [
    "anqr",
    "depcruise",
    "commitlint",
    "lefthook",
    "oxlint",
    "vitest",
    "zustand",
    "radix",
    "lucide",
    "tailwindcss",
    "postcss",
    "sentry",
    "netlify",
    "capacitor",
    "appium",
    "wdio",
    "webdriverio",
    "loglevel",
    "gifenc",
    "gifuct",
    "pngjs",
    "pixelmatch",
    "jsqr",
    "napi",
    "knip",
    "cspell",
    "jscpd",
    "iubenda",
    "brotli",
    "gzip",
    "testid",
    "kebab",
    "admob",
    "rolldown",
    "autoprefixer",
    "precache",
    "sourcemaps",
    "uiautomator",
    "xcuitest",
    "maldous",
    "languagedetector",
    "lhci"
  ],
  "dictionaries": ["typescript", "node", "html", "css", "bash"],
  "overrides": [
    {
      "filename": "**/*.md",
      "dictionaries": ["en_US"]
    }
  ]
}
