{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "@playwright/test"],
    "noImplicitAny": false,
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.spec.ts",
    "scripts/**/*.test.ts",
    "scripts/**/*.d.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "src/**/*.d.ts"
  ]
}
