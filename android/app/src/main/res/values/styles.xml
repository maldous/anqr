<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Opt out of Android 15 edge-to-edge enforcement to fix AdMob interstitial close button visibility -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!--
      Theme for AdMob's full-screen AdActivity.

      We keep it translucent/fullscreen (to match AdMob defaults) and opt-out of
      Android 15 edge-to-edge enforcement so the SDK's close button and its
      hit-target don't end up behind navigation bars / cutouts.
    -->
    <style name="AppTheme.AdMobActivity" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">never</item>
    </style>

    <!--
      Launch theme. Uses a plain NoActionBar parent (NOT Theme.SplashScreen)
      so the Android 12+ system splash doesn't persist on top of the WebView.
      The windowBackground drawable shows for a single frame during cold
      start, then disappears the moment the WebView (and React) paints.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
