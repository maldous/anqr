# API redirect - must come BEFORE the SPA catch-all
# Using 200! (force) to bypass any CDN caching of the SPA fallback
/api/qr    /.netlify/functions/qr    200!

# Legacy endpoint redirect
/api/qr.png    /api/qr    301

# Service Worker files - must be served directly (not caught by SPA fallback)
# These are generated by vite-plugin-pwa at build time
/sw.js    /sw.js    200
/workbox-*.js    /workbox-:splat.js    200
/registerSW.js    /registerSW.js    200

# SPA fallback - all routes serve index.html, letting React Router handle them
# Static assets in /gallery/ folder are served directly before this rule applies
/*    /index.html   200
